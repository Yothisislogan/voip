  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.31.0",
    "@anthropic-ai/sdk": "^0.32.1",
    "@telnyx/webrtc": "2.27.10",
    "@twilio/voice-sdk": "2.18.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "google-auth-library": "^10.9.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.12.0",
    "telnyx": "7.2.0",
    "twilio": "^5.3.0",
    "ws": "^8.18.0"
  }
