{
  "name": "wit-connect-telephony",
  "version": "0.1.0",
  "description": "WIT Connect — Twilio voice starter: browser softphone token, TwiML webhooks, and call/recording logging into the WIT Connect Postgres schema.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node scripts/migrate.js",
    "restore-test": "node scripts/restore-verify.js",
    "simulate": "node scripts/simulate.js",
    "retry-jobs": "node scripts/retry-jobs.js",
    "purge-retention": "node scripts/purge-retention.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.31.0",
    "@anthropic-ai/sdk": "^0.32.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "google-auth-library": "^10.9.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.12.0",
    "twilio": "^5.3.0",
    "ws": "^8.18.0"
  }
}
