{
  "name": "wit-connect-telephony",
  "version": "0.1.0",
  "description": "WiT Connect — durable browser voice, customer identity, transcripts, messaging, and signed WiTnext integration.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node scripts/migrate.js",
    "restore-test": "node scripts/restore-verify.js",
    "simulate": "node scripts/simulate.js",
    "simulate:groq": "node scripts/simulate-groq.js",
    "simulate:witnext": "node scripts/simulate-witnext.js",
    "retry-jobs": "node scripts/retry-jobs.js",
    "purge-retention": "node scripts/purge-retention.js",
    "lint": "eslint src scripts test",
    "test": "node --test",
    "start:render": "node scripts/start-render.js",
    "pilot:init": "node scripts/pilot-env.js",
    "pilot:check": "node scripts/pilot-check.js",
    "pilot:verify-call": "node scripts/pilot-verify-call.js"
