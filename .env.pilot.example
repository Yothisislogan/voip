# Run npm run pilot:init once; edit .env.pilot securely on the target server.
NODE_ENV=production
WIT_DOMAIN=
PUBLIC_BASE_URL=
POSTGRES_PASSWORD=__GENERATE_DB_PASSWORD__
SESSION_SECRET=__GENERATE_SESSION_SECRET__
AUTH_REQUIRED=true
DEV_LOGIN_ENABLED=false
CSRF_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_HOSTED_DOMAIN=weinsurethings.com
AGENT_DIRECTORY=[]
DEFAULT_AGENT_IDENTITY=
TWO_FACTOR_ENABLED=true
TWILIO_VERIFY_SERVICE_SID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Twilio above is retained ONLY for login Verify (and messaging if enabled).
VOICE_PROVIDER=telnyx
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_CONNECTION_ID=
# Dedicated Telnyx pilot number; keep the agency's main routing until acceptance.
TELNYX_CALLER_ID=
TELNYX_PILOT_NUMBER_ID=
TELNYX_MEDIA_SECRET=__GENERATE_MEDIA_SECRET__
TELNYX_RECORDING_HOSTS=recordings.telnyx.com
VOICE_ALLOWED_PREFIXES=+1
VOICE_RECORDING_ENABLED=true
TRANSCRIPTION_PROVIDER=assemblyai
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_STREAMING_URL=wss://streaming.us.assemblyai.com/v3/ws
ASSEMBLYAI_SPEECH_MODEL=universal-streaming-english
ASSEMBLYAI_MAX_CALLS=2
COACHING_ENABLED=true
RECAP_ENABLED=true
LLM_BACKEND=rules
EMAIL_INTAKE_ENABLED=false
MESSAGING_ENABLED=false
SURVEY_ENABLED=false
# Keep integration off until the independent phone pilot works.
WITNEXT_URL=
WITNEXT_INTEGRATION_ID=
WITNEXT_INTEGRATION_SECRET=
