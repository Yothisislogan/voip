# ─── Server ───────────────────────────────────────────────
PORT=3000
# Public base URL Twilio uses to reach your webhooks.
# Locally, run `ngrok http 3000` and paste the https URL here.
PUBLIC_BASE_URL=https://your-ngrok-subdomain.ngrok-free.app

# ─── Twilio account ───────────────────────────────────────
# Console > Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# API Key (Console > Account > API keys & tokens > Create API key)
# Used to sign Voice access tokens for the browser SDK.
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=your_api_key_secret

# TwiML App (Console > Voice > TwiML > TwiML Apps > Create).
# Set the App's Voice Request URL to:  {PUBLIC_BASE_URL}/voice/outbound
TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The WIT phone number outbound browser calls are placed from (E.164).
TWILIO_CALLER_ID=+14805550100

# ─── Routing (starter) ────────────────────────────────────
# Inbound calls ring this browser-client identity. In production this is
# resolved from routing_rules + ring_groups in the database instead.
DEFAULT_AGENT_IDENTITY=marisol.vega

# ─── Database (optional for the voice demo) ───────────────
# Points at the wit_connect_schema.sql database. If unset, the server
# still serves tokens + TwiML, it just skips call logging.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wit_connect

# ─── ERPNext (Frappe) API (optional) ──────────────────────
# ERPNext exposes the Frappe REST API at {BASE}/api/resource with token auth.
# If these are unset, screen-pop + recap silently skip (phone still works).
# Generate credentials in ERPNext: User > Settings > API Access > Generate Keys
# (use a dedicated integration user with Contact/Lead/Communication access).
ERPNEXT_BASE_URL=https://erp.example.com
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
# Base URL the agent UI links to (defaults to ERPNEXT_BASE_URL).
ERPNEXT_UI_URL=

# ─── Anthropic / Claude (optional) ────────────────────────
# Powers real-time sales coaching + the end-of-call recap.
# If the chosen backend isn't configured, both features silently skip.
#
# Backend: "anthropic" (direct API) or "bedrock" (Amazon Bedrock — keeps data in
# your AWS account/region under your BAA). See docs/secure-ai-architecture.md.
LLM_BACKEND=anthropic

# Direct Anthropic API (LLM_BACKEND=anthropic):
ANTHROPIC_API_KEY=

# Amazon Bedrock (LLM_BACKEND=bedrock): needs AWS_REGION + AWS credentials via
# the standard AWS chain (env vars, profile, or IAM role). No ANTHROPIC_API_KEY.
# Model IDs below are auto-prefixed with "anthropic." for Bedrock.
AWS_REGION=

# Model IDs are written bare for both backends.
ANTHROPIC_MODEL=claude-opus-4-8
# Real-time coaching cues are latency-sensitive. Point this at a faster
# model (e.g. claude-haiku-4-5) if cue latency matters more than depth.
# Defaults to ANTHROPIC_MODEL.
ANTHROPIC_COACHING_MODEL=

# ─── AI feature flags ─────────────────────────────────────
COACHING_ENABLED=true
RECAP_ENABLED=true
# Minimum ms between coaching LLM calls per call (cost/latency guard).
COACHING_THROTTLE_MS=6000

# ─── Authentication: Google OAuth + Twilio Verify 2FA ─────
# Secure by default. Set AUTH_REQUIRED=false ONLY for local dev — it BYPASSES
# login and injects DEV_IDENTITY. Never set false in production.
AUTH_REQUIRED=true
DEV_IDENTITY=marisol.vega
# Strong random secret that signs the session cookie (e.g. `openssl rand -hex 32`).
SESSION_SECRET=
SESSION_COOKIE_NAME=wit_session
SESSION_TTL_SEC=28800

# Google OAuth client (console.cloud.google.com → APIs & Services → Credentials
# → OAuth client ID → Web application). Add the redirect URI below to the client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to {PUBLIC_BASE_URL}/auth/google/callback if unset.
GOOGLE_REDIRECT_URI=
# Optional: restrict logins to one Google Workspace domain (extra guard).
GOOGLE_HOSTED_DOMAIN=

# Second factor via Twilio Verify (Console → Verify → Services → create one).
TWO_FACTOR_ENABLED=true
TWILIO_VERIFY_SERVICE_SID=

# Agent allowlist: JSON array mapping verified Google emails -> Twilio identity
# + MFA target. mfaChannel is "sms" (uses phone) or "email" (uses mfaEmail or
# the login email). Only listed emails can sign in.
AGENT_DIRECTORY=[{"email":"marisol.vega@weinsurethings.com","identity":"marisol.vega","name":"Marisol Vega","mfaChannel":"sms","phone":"+14805550100"}]

# Cross-origin allowlist for browser fetches (comma-separated). Empty = same-origin only.
ALLOWED_ORIGINS=
