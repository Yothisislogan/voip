# ─── Server ───────────────────────────────────────────────
PORT=3000
# Public base URL Twilio uses to reach your webhooks.
# Locally, run `ngrok http 3000` and paste the https URL here.
PUBLIC_BASE_URL=https://your-ngrok-subdomain.ngrok-free.app

# ─── Twilio account ───────────────────────────────────────
# Console > Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# API Key (Console > Account > API keys & tokens > Create API key)
# Used to sign Voice access tokens for the browser SDK.
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=your_api_key_secret

# TwiML App (Console > Voice > TwiML > TwiML Apps > Create).
# Set the App's Voice Request URL to:  {PUBLIC_BASE_URL}/voice/outbound
TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The WIT phone number outbound browser calls are placed from (E.164).
TWILIO_CALLER_ID=+14805550100

# ─── Routing (starter) ────────────────────────────────────
# Inbound calls ring this browser-client identity. In production this is
# resolved from routing_rules + ring_groups in the database instead.
DEFAULT_AGENT_IDENTITY=marisol.vega

# ─── Database (optional for the voice demo) ───────────────
# Points at the wit_connect_schema.sql database. If unset, the server
# still serves tokens + TwiML, it just skips call logging.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wit_connect

# ─── Messaging: SMS now, Apple Messages for Business later (optional) ──
# Provider-agnostic messaging layer. Today via Twilio Conversations (SMS/
# WhatsApp); Apple Messages for Business plugs in when an Apple-approved MSP is
# live. If unconfigured, messaging is disabled and voice is unaffected.
MESSAGING_ENABLED=true
MESSAGING_PROVIDER=twilio_conversations
# Twilio Conversations service that owns the conversations + webhooks.
TWILIO_CONVERSATIONS_SERVICE_SID=
# Author label on our outbound messages (distinguishes them from customer ones).
MESSAGING_BUSINESS_AUTHOR=wit-connect
# Point the Twilio Conversations "onMessageAdded" webhook at:
#   {PUBLIC_BASE_URL}/messaging/inbound

# ─── Postgres CRM data pipeline (optional) ────────────────
# With DATABASE_URL set, the app owns a Postgres CRM (contacts/leads, calls,
# transcript_segments, call_scores, surveys, email_intake). Apply with
# `npm run migrate` (docker-compose runs it automatically). See db/schema.sql.
# (DATABASE_URL is defined in the Database section below / injected by compose.)

# Post-call survey SMS (opt-in). Sends after each call; replies capture a 1-5 rating.
SURVEY_ENABLED=false
SURVEY_TEXT=Thanks for speaking with We Insure Things! How likely are you to recommend us? Reply 1-5.

# Inbound email intake (SendGrid/Mailgun inbound-parse → leads).
# Point the provider webhook at {PUBLIC_BASE_URL}/email/inbound.
EMAIL_INTAKE_ENABLED=true
# Optional shared secret required as ?token= or X-Intake-Token header.
EMAIL_INBOUND_TOKEN=

# For docker-compose: the Postgres password (compose builds DATABASE_URL from it).
POSTGRES_PASSWORD=change-me

# ─── ERPNext (Frappe) API (optional) ──────────────────────
# ERPNext exposes the Frappe REST API at {BASE}/api/resource with token auth.
# If these are unset, screen-pop + recap silently skip (phone still works).
# Generate credentials in ERPNext: User > Settings > API Access > Generate Keys
# (use a dedicated integration user with Contact/Lead/Communication access).
ERPNEXT_BASE_URL=https://erp.example.com
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
# Base URL the agent UI links to (defaults to ERPNEXT_BASE_URL).
ERPNEXT_UI_URL=

# ─── Anthropic / Claude (optional) ────────────────────────
# Powers real-time sales coaching + the end-of-call recap.
# If the chosen backend isn't configured, both features silently skip.
#
# Backend selects the AI provider (Claude is OPTIONAL):
#   rules     = deterministic local coach (default; no key/GPU/service)
#   ollama    = tiny local LLM with automatic rules fallback
#   groq      = Groq API (fast hosted Llama)  (needs GROQ_API_KEY)
#   anthropic = direct Claude API           (needs ANTHROPIC_API_KEY)
#   bedrock   = Claude via Amazon Bedrock    (needs AWS_REGION + AWS creds)
# See docs/local-ai-backends.md and docs/secure-ai-architecture.md.
LLM_BACKEND=rules

# Per-task backends. Live coaching is LOCAL-first and never uses a cloud LLM
# unless you set LLM_COACHING_BACKEND explicitly. Recap/extraction follow
# LLM_RECAP_BACKEND; automation follows LLM_AUTOMATION_BACKEND. Recommended Groq
# split (Twilio transcription stays; rules remain the fallback):
#   LLM_BACKEND=groq
#   LLM_RECAP_BACKEND=groq        # recap + CRM extraction on Llama-3.3-70B
#   LLM_COACHING_BACKEND=rules    # keep real-time coaching local (or groq=8B)
#   LLM_AUTOMATION_BACKEND=groq   # heavy on-demand tasks on GPT-OSS-120B
LLM_COACHING_BACKEND=
LLM_RECAP_BACKEND=
LLM_AUTOMATION_BACKEND=

# Groq (OpenAI-compatible). 70B for recap/extraction, 8B for coaching, 120B for
# on-demand automation only (never per-call). Rules fall back on any failure.
GROQ_API_KEY=
GROQ_RECAP_MODEL=llama-3.3-70b-versatile
GROQ_COACHING_MODEL=llama-3.1-8b-instant
GROQ_AUTOMATION_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_MS=10000
# GROQ_COACHING_TIMEOUT_MS=2500
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# AI-extracted CRM fields at/above this confidence auto-apply; the rest surface
# as "AI found these updates. Apply?" for the agent to confirm.
# AI_EXTRACT_AUTOAPPLY_CONFIDENCE=0.85

# Direct Anthropic API (recap):
ANTHROPIC_API_KEY=
# Amazon Bedrock (recap): AWS_REGION + AWS creds; no API key. Model IDs auto-prefixed.
AWS_REGION=

# Tiny local LLM (Ollama) — used when a backend is "ollama":
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_COACHING_MODEL=
OLLAMA_RECAP_MODEL=
LOCAL_LLM_TIMEOUT_MS=1200
OLLAMA_RECAP_TIMEOUT_MS=8000
OLLAMA_CONTEXT_TOKENS=2048

# Claude model IDs, written bare for both anthropic + bedrock:
ANTHROPIC_MODEL=claude-opus-4-8
# Coaching only uses Claude if you opt in via LLM_COACHING_BACKEND; if so, a
# faster model (e.g. claude-haiku-4-5) reduces cue latency. Defaults to ANTHROPIC_MODEL.
ANTHROPIC_COACHING_MODEL=

# ─── AI feature flags ─────────────────────────────────────
COACHING_ENABLED=true
RECAP_ENABLED=true
# Minimum ms between coaching LLM calls per call (cost/latency guard).
COACHING_THROTTLE_MS=6000

# ─── Authentication: Google OAuth + Twilio Verify 2FA ─────
# Secure by default. Set AUTH_REQUIRED=false ONLY for local dev — it BYPASSES
# login and injects DEV_IDENTITY. Never set false in production.
AUTH_REQUIRED=true
DEV_IDENTITY=marisol.vega
# Temporary developer login: when true, the login page shows a "Continue as
# developer" option that issues a session WITHOUT Google/2FA. Keeps auth on
# (unlike AUTH_REQUIRED=false). For testing only — remove before production.
DEV_LOGIN_ENABLED=false
# Strong random secret that signs the session cookie (e.g. `openssl rand -hex 32`).
SESSION_SECRET=
SESSION_COOKIE_NAME=wit_session
SESSION_TTL_SEC=28800

# Google OAuth client (console.cloud.google.com → APIs & Services → Credentials
# → OAuth client ID → Web application). Add the redirect URI below to the client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to {PUBLIC_BASE_URL}/auth/google/callback if unset.
GOOGLE_REDIRECT_URI=
# Optional: restrict logins to one Google Workspace domain (extra guard).
GOOGLE_HOSTED_DOMAIN=

# Second factor via Twilio Verify (Console → Verify → Services → create one).
TWO_FACTOR_ENABLED=true
TWILIO_VERIFY_SERVICE_SID=

# Agent allowlist: JSON array mapping verified Google emails -> Twilio identity
# + MFA target. mfaChannel is "sms" (uses phone) or "email" (uses mfaEmail or
# the login email). Only listed emails can sign in.
#
# Optional "role" per entry controls permissions (default "agent" if omitted):
#   viewer — read-only: browse contacts/calls, but cannot edit CRM or send messages
#   agent  — full call handling: view/edit CRM data, send messages (default)
#   admin  — everything agent can do (reserved for future admin-only surfaces)
AGENT_DIRECTORY=[{"email":"marisol.vega@weinsurethings.com","identity":"marisol.vega","name":"Marisol Vega","mfaChannel":"sms","phone":"+14805550100","role":"agent"}]

# Cross-origin allowlist for browser fetches (comma-separated). Empty = same-origin only.
ALLOWED_ORIGINS=

# ── WiTNext CRM bridge (WIT Connect = integration broker) ──
# Call/recap/transcript/recording/email events are normalized, HMAC-signed, and
# forwarded to the WiTNext integration API. Inert until BOTH values are set.
# See docs/witnext-integration-contract.md for the wire format.
WITNEXT_URL=
WITNEXT_INTEGRATION_SECRET=
# WITNEXT_CALL_EVENTS_PATH=/api/v1/integrations/dialpad/events
# WITNEXT_EMAIL_EVENTS_PATH=/api/v1/integrations/email/events
# WITNEXT_TIMEOUT_MS=8000

# Dialpad inbound webhooks (experimental). Dialpad signs events as an HS256 JWT
# with this secret; unsigned events are rejected. Enables POST /dialpad/events.
DIALPAD_WEBHOOK_SECRET=

# ── Observability ──
# Structured logs: level = debug|info|warn|error. LOG_PRETTY=true forces the
# human-readable format (default in non-production); production emits JSON lines.
LOG_LEVEL=info
# LOG_PRETTY=false

# ── Security hardening ──
# CSRF on cookie-authed browser POST/PATCH. Defaults on whenever auth is required.
# CSRF_ENABLED=true
# Content-Security-Policy override (advanced). A safe default ships in code.
# CONTENT_SECURITY_POLICY=
# HSTS max-age (seconds) sent only over https. Default 180 days.
# HSTS_MAX_AGE=15552000
# Per-IP rate limits (fixed window). Auth is strict; webhooks are loose.
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_API_MAX=300
# RATE_LIMIT_AUTH_MAX=20
# RATE_LIMIT_WEBHOOK_MAX=600
# Read client IP from X-Forwarded-For (needed behind Caddy/Cloudflare). Default true.
# RATE_LIMIT_TRUST_PROXY=true
# Trusted proxy hops appended to X-Forwarded-For: 1 = Caddy/Render alone (default),
# 2 = Cloudflare in front of Caddy. Entries beyond these are client-forgeable.
# RATE_LIMIT_TRUST_HOPS=1

# ── Data retention (days; 0 = keep forever). Enforced by `npm run purge-retention`. ──
RETENTION_TRANSCRIPT_DAYS=0
RETENTION_RECORDING_DAYS=0
RETENTION_AUDIT_DAYS=0
# Also delete the audio at Twilio (not just the local URL) during purge.
# RETENTION_DELETE_TWILIO_RECORDINGS=false
