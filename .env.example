# ─── Server ───────────────────────────────────────────────
PORT=3000
# Public base URL Twilio uses to reach your webhooks.
# Locally, run `ngrok http 3000` and paste the https URL here.
PUBLIC_BASE_URL=https://your-ngrok-subdomain.ngrok-free.app

# ─── Twilio account ───────────────────────────────────────
# Console > Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# API Key (Console > Account > API keys & tokens > Create API key)
# Used to sign Voice access tokens for the browser SDK.
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=your_api_key_secret

# TwiML App (Console > Voice > TwiML > TwiML Apps > Create).
# Set the App's Voice Request URL to:  {PUBLIC_BASE_URL}/voice/outbound
TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The WIT phone number outbound browser calls are placed from (E.164).
TWILIO_CALLER_ID=+14805550100

# ─── Routing (starter) ────────────────────────────────────
# Inbound calls ring this browser-client identity. In production this is
# resolved from routing_rules + ring_groups in the database instead.
DEFAULT_AGENT_IDENTITY=marisol.vega

# ─── Database (optional for the voice demo) ───────────────
# Points at the wit_connect_schema.sql database. If unset, the server
# still serves tokens + TwiML, it just skips call logging.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wit_connect

# ─── SuiteCRM V8 API (optional) ───────────────────────────
# SuiteCRM 7.10+ exposes the V8 JSON:API at {BASE}/Api/V8 with OAuth2.
# If these are unset, screen-pop + recap silently skip (phone still works).
# Generate a client in SuiteCRM: Admin > OAuth2 Clients and Tokens >
# "New Password Client" (use the password grant with a dedicated agent user).
SUITECRM_BASE_URL=https://crm.example.com
SUITECRM_CLIENT_ID=
SUITECRM_CLIENT_SECRET=
# Password grant (recommended). Leave blank to use client_credentials instead.
SUITECRM_USERNAME=
SUITECRM_PASSWORD=
# Base URL the agent UI links to (defaults to SUITECRM_BASE_URL).
SUITECRM_UI_URL=

# ─── Anthropic / Claude (optional) ────────────────────────
# Powers real-time sales coaching + the end-of-call recap.
# If unset, both features silently skip.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
# Real-time coaching cues are latency-sensitive. Point this at a faster
# model (e.g. claude-haiku-4-5) if cue latency matters more than depth.
# Defaults to ANTHROPIC_MODEL.
ANTHROPIC_COACHING_MODEL=

# ─── AI feature flags ─────────────────────────────────────
COACHING_ENABLED=true
RECAP_ENABLED=true
# Minimum ms between coaching LLM calls per call (cost/latency guard).
COACHING_THROTTLE_MS=6000
